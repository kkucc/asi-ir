    "        fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "        fig.suptitle(f'Обработка файла: {os.path.basename(file_path)}', fontsize=14)\n",
    "\n",
    "\n",
    "        axes[0].set_title('До')\n",
